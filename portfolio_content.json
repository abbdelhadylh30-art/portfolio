{
  "code": 200,
  "data": {
    "description": "",
    "external": {},
    "html": "<html lang=\"en\"><head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Mohamed Medhat - Marketing &amp; Growth</title>\n  <style>\n    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;700&family=DM+Sans:wght@300;400;500&display=swap');\n    *{box-sizing:border-box;margin:0;padding:0}\n    :root{\n      --primary:#1a1a2e;--accent:#c8963e;--accent2:#e8b85a;\n      --bg:#f8f6f1;--surface:#ffffff;--muted:#6b6560;\n      --border:#e2ddd6;--text:#1a1a1e;\n    }\n    body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--text);min-height:100vh}\n    .port{max-width:900px;margin:0 auto;padding:0 20px 80px}\n\n    /* NAV */\n    .nav{display:flex;justify-content:space-between;align-items:center;padding:24px 0 20px;border-bottom:1px solid var(--border);margin-bottom:40px}\n    .nav-brand{font-family:'Playfair Display',serif;font-size:18px;font-weight:700;letter-spacing:-0.3px;color:var(--primary)}\n    .nav-links{display:flex;gap:6px;align-items:center;flex-wrap:wrap}\n    .nav-btn{background:none;border:none;padding:6px 12px;font-size:13px;font-family:'DM Sans',sans-serif;color:var(--muted);cursor:pointer;border-radius:6px;transition:all 0.2s}\n    .nav-btn:hover,.nav-btn.active{background:var(--primary);color:#fff}\n    .admin-btn{background:var(--accent);color:#fff;padding:6px 14px;border:none;border-radius:6px;font-size:12px;cursor:pointer;font-weight:500}\n    .admin-btn:hover{opacity:0.85}\n\n    /* PAGES */\n    .page{display:none}.page.active{display:block}\n\n    /* HERO */\n    .hero{padding:20px 0 50px}\n    .hero-top{display:grid;grid-template-columns:1fr;gap:40px;align-items:start;margin-bottom:40px}\n    .hero-tag{display:inline-block;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--accent);font-weight:500;margin-bottom:14px}\n    .hero-name{font-family:'Playfair Display',serif;font-size:52px;font-weight:700;line-height:1.05;color:var(--primary);margin-bottom:16px}\n    .hero-name span{color:var(--accent)}\n    .hero-desc{font-size:15px;line-height:1.7;color:var(--muted);max-width:480px;margin-bottom:24px}\n    .hero-cta{display:flex;gap:10px;flex-wrap:wrap}\n    .btn-primary{background:var(--primary);color:#fff;border:none;padding:10px 22px;border-radius:8px;font-size:13px;font-family:'DM Sans',sans-serif;cursor:pointer;font-weight:500;transition:opacity 0.2s}\n    .btn-primary:hover{opacity:0.85}\n    .btn-secondary{background:none;border:1.5px solid var(--border);color:var(--primary);padding:10px 22px;border-radius:8px;font-size:13px;font-family:'DM Sans',sans-serif;cursor:pointer;font-weight:500;transition:all 0.2s}\n    .btn-secondary:hover{border-color:var(--primary)}\n\n    /* STATS */\n    .stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:40px}\n    .stat-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:16px 18px}\n    .stat-num{font-family:'Playfair Display',serif;font-size:28px;font-weight:700;color:var(--primary);margin-bottom:2px}\n    .stat-label{font-size:12px;color:var(--muted)}\n\n    /* SECTION TITLES */\n    .section-head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:20px;padding-bottom:10px;border-bottom:1px solid var(--border)}\n    .section-title{font-family:'Playfair Display',serif;font-size:22px;font-weight:700;color:var(--primary)}\n    .section-link{font-size:13px;color:var(--accent);cursor:pointer;background:none;border:none;font-family:'DM Sans',sans-serif}\n    .section-link:hover{text-decoration:underline}\n\n    /* PROJECT CARDS */\n    .projects-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:40px}\n    .proj-card{background:var(--surface);border:1px solid var(--border);border-radius:14px;overflow:hidden;cursor:pointer;transition:transform 0.2s,box-shadow 0.2s;position:relative}\n    .proj-card:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,0.08)}\n    .proj-thumb{height:140px;display:flex;align-items:center;justify-content:center;font-size:36px;position:relative;overflow:hidden}\n    .proj-thumb-label{position:absolute;bottom:0;left:0;right:0;padding:10px 14px;background:rgba(0,0,0,0.5);backdrop-filter:blur(4px)}\n    .proj-thumb-name{color:#fff;font-family:'Playfair Display',serif;font-size:16px;font-weight:700}\n    .proj-thumb-sub{color:rgba(255,255,255,0.7);font-size:11px}\n    .proj-body{padding:14px 16px}\n    .proj-tags{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px}\n    .proj-tag{font-size:11px;padding:3px 8px;border-radius:20px;background:#f0ede8;color:var(--muted);font-weight:500}\n    .proj-desc{font-size:13px;color:var(--muted);line-height:1.6}\n    .delete-btn{background:#e74c3c;color:#fff;border:none;padding:6px 10px;border-radius:4px;cursor:pointer;margin-top:10px;font-size:11px;display:none}\n    .admin-mode .delete-btn{display:block}\n\n    /* EXPERIENCE */\n    .exp-list{display:flex;flex-direction:column;gap:0}\n    .exp-item{padding:20px 0;border-bottom:1px solid var(--border);display:grid;grid-template-columns:auto 1fr;gap:16px;align-items:start}\n    .exp-item:last-child{border-bottom:none}\n    .exp-dot{width:10px;height:10px;border-radius:50%;background:var(--accent);margin-top:5px;flex-shrink:0}\n    .exp-role{font-weight:500;font-size:15px;color:var(--primary);margin-bottom:2px}\n    .exp-company{font-size:13px;color:var(--accent);margin-bottom:4px}\n    .exp-date{font-size:12px;color:var(--muted);margin-bottom:8px}\n    .exp-bullets{list-style:none;padding:0}\n    .exp-bullets li{font-size:13px;color:var(--muted);line-height:1.6;padding-left:14px;position:relative;margin-bottom:4px}\n    .exp-bullets li::before{content:'—';position:absolute;left:0;color:var(--accent)}\n\n    /* SKILLS */\n    .skills-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:40px}\n    .skill-group{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:18px}\n    .skill-group-title{font-size:13px;font-weight:500;color:var(--primary);margin-bottom:12px;text-transform:uppercase;letter-spacing:1px}\n    .skill-tags{display:flex;flex-wrap:wrap;gap:6px}\n    .skill-tag{font-size:12px;padding:4px 10px;border-radius:20px;border:1px solid var(--border);color:var(--primary);font-weight:400}\n\n    /* ADMIN PANEL */\n    .admin-panel{position:fixed;right:0;top:0;width:400px;height:100vh;background:#fff;border-left:1px solid var(--border);box-shadow:-2px 0 10px rgba(0,0,0,0.1);overflow-y:auto;transform:translateX(100%);transition:transform 0.3s;z-index:1000;padding:20px}\n    .admin-panel.open{transform:translateX(0)}\n    .admin-close{background:none;border:none;font-size:24px;cursor:pointer;position:absolute;top:20px;right:20px;color:var(--muted)}\n    .admin-close:hover{color:var(--primary)}\n    .admin-title{font-size:18px;font-weight:700;margin-bottom:20px;margin-top:20px}\n    .admin-section{margin-bottom:30px}\n    .admin-section-title{font-size:13px;font-weight:600;color:var(--accent);text-transform:uppercase;margin-bottom:12px}\n    .admin-input,\n    .admin-textarea{width:100%;padding:8px 12px;border:1px solid var(--border);border-radius:6px;font-family:'DM Sans',sans-serif;font-size:13px;margin-bottom:10px}\n    .admin-textarea{resize:vertical;min-height:80px}\n    .admin-btn-group{display:flex;gap:8px}\n    .admin-btn-group button{flex:1;padding:8px;border:none;border-radius:6px;cursor:pointer;font-size:12px;font-weight:500}\n    .admin-btn-save{background:var(--primary);color:#fff}\n    .admin-btn-save:hover{opacity:0.85}\n    .admin-btn-cancel{background:var(--border);color:var(--primary)}\n    .admin-btn-cancel:hover{background:#e2ddd6}\n\n    .notification{position:fixed;top:20px;right:20px;background:var(--primary);color:#fff;padding:12px 16px;border-radius:6px;font-size:13px;z-index:10000;animation:slideIn 0.3s}\n    @keyframes slideIn{from{transform:translateX(400px);opacity:0}to{transform:translateX(0);opacity:1}}\n\n    @media(max-width:768px){\n      .hero-top{grid-template-columns:1fr}\n      .stats-row{grid-template-columns:repeat(2,1fr)}\n      .projects-grid{grid-template-columns:1fr}\n      .skills-grid{grid-template-columns:1fr}\n      .admin-panel{width:100%;max-width:350px}\n    }\n  </style>\n</head>\n<body>\n<div class=\"port\">\n  <nav class=\"nav\">\n    <div class=\"nav-brand\">Mohamed Medhat</div>\n    <div class=\"nav-links\">\n      <button class=\"nav-btn active\" onclick=\"showPage('home')\">Home</button>\n      <button class=\"nav-btn\" onclick=\"showPage('projects')\">Projects</button>\n      <button class=\"nav-btn\" onclick=\"showPage('experience')\">Experience</button>\n      <button class=\"nav-btn\" onclick=\"showPage('about')\">About</button>\n      <button class=\"nav-btn\" onclick=\"showPage('contact')\">Contact</button>\n      <button class=\"admin-btn\" onclick=\"toggleAdmin()\">⚙️ Edit</button>\n    </div>\n  </nav>\n\n  <!-- HOME -->\n  <div id=\"page-home\" class=\"page active\">\n    <div class=\"hero\">\n      <div class=\"hero-top\">\n        <div>\n          <span class=\"hero-tag\">Marketing · Growth · Strategy</span>\n          <h1 class=\"hero-name\">Mohamed<br><span>Medhat</span></h1>\n          <p class=\"hero-desc\">Marketing &amp; International Business graduate building brands, launching campaigns, and driving growth across Egypt's most competitive consumer markets.</p>\n          <div class=\"hero-cta\">\n            <button class=\"btn-primary\" onclick=\"showPage('projects')\">View My Work</button>\n            <button class=\"btn-secondary\" onclick=\"showPage('contact')\">Get In Touch</button>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"stats-row\">\n        <div class=\"stat-card\">\n          <div class=\"stat-num\">3+</div>\n          <div class=\"stat-label\">Internships completed</div>\n        </div>\n        <div class=\"stat-card\">\n          <div class=\"stat-num\">5</div>\n          <div class=\"stat-label\">Campaign concepts developed</div>\n        </div>\n        <div class=\"stat-card\">\n          <div class=\"stat-num\">3</div>\n          <div class=\"stat-label\">Brand case studies</div>\n        </div>\n        <div class=\"stat-card\">\n          <div class=\"stat-num\">2</div>\n          <div class=\"stat-label\">Degrees (dual)</div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"section-head\">\n      <span class=\"section-title\">Featured Projects</span>\n      <button class=\"section-link\" onclick=\"showPage('projects')\">View all →</button>\n    </div>\n    <div id=\"featured-projects\" class=\"projects-grid\" style=\"margin-bottom:40px\"><div class=\"proj-card \">\n    <div class=\"proj-thumb\" style=\"background:linear-gradient(135deg,#cc0000,#ff4444)\">\n      <div class=\"proj-thumb-label\">\n        <div class=\"proj-thumb-name\">Pizza Station</div>\n        <div class=\"proj-thumb-sub\">Brand Analysis &amp; Campaign Strategy</div>\n      </div>\n    </div>\n    <div class=\"proj-body\">\n      <div class=\"proj-tags\"><span class=\"proj-tag\">Campaign</span><span class=\"proj-tag\">Analysis</span><span class=\"proj-tag\">Meta Ads</span></div>\n      <p class=\"proj-desc\">Full competitive audit + two original campaign concepts</p>\n      <button class=\"delete-btn\" onclick=\"deleteProject(1)\">🗑 Delete</button>\n    </div>\n  </div><div class=\"proj-card \">\n    <div class=\"proj-thumb\" style=\"background:linear-gradient(135deg,#bf4a00,#e86e1e)\">\n      <div class=\"proj-thumb-label\">\n        <div class=\"proj-thumb-name\">Maine Egypt</div>\n        <div class=\"proj-thumb-sub\">Social Strategy &amp; Campaign Design</div>\n      </div>\n    </div>\n    <div class=\"proj-body\">\n      <div class=\"proj-tags\"><span class=\"proj-tag\">F&amp;B</span><span class=\"proj-tag\">Social Media</span><span class=\"proj-tag\">Events</span></div>\n      <p class=\"proj-desc\">Premium burger brand digital audit and campaign concept</p>\n      <button class=\"delete-btn\" onclick=\"deleteProject(2)\">🗑 Delete</button>\n    </div>\n  </div></div>\n\n    <div class=\"section-head\">\n      <span class=\"section-title\">Skills</span>\n    </div>\n    <div id=\"skills-section\" class=\"skills-grid\">\n    <div class=\"skill-group\">\n      <div class=\"skill-group-title\">Marketing &amp; Campaigns</div>\n      <div class=\"skill-tags\"><span class=\"skill-tag\">Campaign Planning</span><span class=\"skill-tag\">BTL Execution</span><span class=\"skill-tag\">Meta Ads Manager</span><span class=\"skill-tag\">Content Strategy</span><span class=\"skill-tag\">Brand Management</span><span class=\"skill-tag\">Performance Reporting</span></div>\n    </div>\n  \n    <div class=\"skill-group\">\n      <div class=\"skill-group-title\">Business Development</div>\n      <div class=\"skill-tags\"><span class=\"skill-tag\">Market Research</span><span class=\"skill-tag\">Competitor Analysis</span><span class=\"skill-tag\">Lead Generation</span><span class=\"skill-tag\">Sales Presentations</span><span class=\"skill-tag\">Stakeholder Comms</span></div>\n    </div>\n  \n    <div class=\"skill-group\">\n      <div class=\"skill-group-title\">Analytics &amp; Reporting</div>\n      <div class=\"skill-tags\"><span class=\"skill-tag\">KPI Tracking</span><span class=\"skill-tag\">Data Analysis</span><span class=\"skill-tag\">Trend Analysis</span><span class=\"skill-tag\">Microsoft Excel</span></div>\n    </div>\n  \n    <div class=\"skill-group\">\n      <div class=\"skill-group-title\">Languages &amp; Tools</div>\n      <div class=\"skill-tags\"><span class=\"skill-tag\">Arabic (Native)</span><span class=\"skill-tag\">English (C1)</span><span class=\"skill-tag\">PowerPoint</span><span class=\"skill-tag\">Word</span></div>\n    </div>\n  </div>\n  </div>\n\n  <!-- PROJECTS -->\n  <div id=\"page-projects\" class=\"page\">\n    <div class=\"section-head\">\n      <span class=\"section-title\">All Projects</span>\n    </div>\n    <div id=\"all-projects\" class=\"projects-grid\"><div class=\"proj-card \">\n    <div class=\"proj-thumb\" style=\"background:linear-gradient(135deg,#cc0000,#ff4444)\">\n      <div class=\"proj-thumb-label\">\n        <div class=\"proj-thumb-name\">Pizza Station</div>\n        <div class=\"proj-thumb-sub\">Brand Analysis &amp; Campaign Strategy</div>\n      </div>\n    </div>\n    <div class=\"proj-body\">\n      <div class=\"proj-tags\"><span class=\"proj-tag\">Campaign</span><span class=\"proj-tag\">Analysis</span><span class=\"proj-tag\">Meta Ads</span></div>\n      <p class=\"proj-desc\">Full competitive audit + two original campaign concepts</p>\n      <button class=\"delete-btn\" onclick=\"deleteProject(1)\">🗑 Delete</button>\n    </div>\n  </div><div class=\"proj-card \">\n    <div class=\"proj-thumb\" style=\"background:linear-gradient(135deg,#bf4a00,#e86e1e)\">\n      <div class=\"proj-thumb-label\">\n        <div class=\"proj-thumb-name\">Maine Egypt</div>\n        <div class=\"proj-thumb-sub\">Social Strategy &amp; Campaign Design</div>\n      </div>\n    </div>\n    <div class=\"proj-body\">\n      <div class=\"proj-tags\"><span class=\"proj-tag\">F&amp;B</span><span class=\"proj-tag\">Social Media</span><span class=\"proj-tag\">Events</span></div>\n      <p class=\"proj-desc\">Premium burger brand digital audit and campaign concept</p>\n      <button class=\"delete-btn\" onclick=\"deleteProject(2)\">🗑 Delete</button>\n    </div>\n  </div><div class=\"proj-card \">\n    <div class=\"proj-thumb\" style=\"background:linear-gradient(135deg,#0a0a0a,#2d2d2d)\">\n      <div class=\"proj-thumb-label\">\n        <div class=\"proj-thumb-name\">Pablo &amp; Abdo</div>\n        <div class=\"proj-thumb-sub\">Brand Strategy &amp; Content Campaigns</div>\n      </div>\n    </div>\n    <div class=\"proj-body\">\n      <div class=\"proj-tags\"><span class=\"proj-tag\">Brand Identity</span><span class=\"proj-tag\">Storytelling</span><span class=\"proj-tag\">UGC</span></div>\n      <p class=\"proj-desc\">GTA-themed fusion brand with activation campaigns</p>\n      <button class=\"delete-btn\" onclick=\"deleteProject(3)\">🗑 Delete</button>\n    </div>\n  </div><div class=\"proj-card \">\n    <div class=\"proj-thumb\" style=\"background:linear-gradient(135deg,#1a3a6e,#2d5fb5)\">\n      <div class=\"proj-thumb-label\">\n        <div class=\"proj-thumb-name\">AI &amp; Smart Business</div>\n        <div class=\"proj-thumb-sub\">Academic Research Project</div>\n      </div>\n    </div>\n    <div class=\"proj-body\">\n      <div class=\"proj-tags\"><span class=\"proj-tag\">Research</span><span class=\"proj-tag\">AI Strategy</span></div>\n      <p class=\"proj-desc\">Market intelligence research on AI-driven business tools</p>\n      <button class=\"delete-btn\" onclick=\"deleteProject(4)\">🗑 Delete</button>\n    </div>\n  </div></div>\n  </div>\n\n  <!-- EXPERIENCE -->\n  <div id=\"page-experience\" class=\"page\">\n    <div class=\"section-head\">\n      <span class=\"section-title\">Experience</span>\n    </div>\n    <div id=\"experience-section\" class=\"exp-list\">\n    <div class=\"exp-item\">\n      <div class=\"exp-dot\"></div>\n      <div>\n        <div class=\"exp-role\">Customer Relationship Manager</div>\n        <div class=\"exp-company\">Confidential — Marketing Operations, Giza</div>\n        <div class=\"exp-date\">Sep 2023 – Feb 2025</div>\n        <ul class=\"exp-bullets\"><li>Monitored client interaction data weekly, delivering trend insights directly applicable to campaign performance monitoring</li><li>Managed concurrent workflows across multiple client accounts with structured records and KPI tracking</li><li>Coordinated with internal teams and third-party vendors across deliverables and deadlines</li><li>Promoted within 12 months based on consistent output quality in a high-volume environment</li></ul>\n      </div>\n    </div>\n  \n    <div class=\"exp-item\">\n      <div class=\"exp-dot\"></div>\n      <div>\n        <div class=\"exp-role\">Sales and Marketing Supervisor</div>\n        <div class=\"exp-company\">Mining City, Cairo</div>\n        <div class=\"exp-date\">Nov 2019 – Dec 2020</div>\n        <ul class=\"exp-bullets\"><li>Planned and executed BTL promotional campaigns for investment products, managing full delivery from strategy through activation</li><li>Led a team of 10, setting performance targets and tracking KPIs</li><li>Conducted competitive market analysis to identify positioning opportunities</li><li>Produced regular performance reports for senior-level decision-making</li></ul>\n      </div>\n    </div>\n  \n    <div class=\"exp-item\">\n      <div class=\"exp-dot\"></div>\n      <div>\n        <div class=\"exp-role\">Marketing Intern</div>\n        <div class=\"exp-company\">Elsewedy Trading Enterprises, Cairo</div>\n        <div class=\"exp-date\">Jun 2023 – Jul 2023</div>\n        <ul class=\"exp-bullets\"><li>Supported planning and deployment of paid advertising campaigns across digital channels</li><li>Conducted competitive intelligence research to identify market opportunities</li><li>Contributed customer acquisition ideas adopted into the team's promotional strategy</li></ul>\n      </div>\n    </div>\n  \n    <div class=\"exp-item\">\n      <div class=\"exp-dot\"></div>\n      <div>\n        <div class=\"exp-role\">Business Development Intern</div>\n        <div class=\"exp-company\">Scientific and Trading, Cairo</div>\n        <div class=\"exp-date\">Feb 2023 – Mar 2023</div>\n        <ul class=\"exp-bullets\"><li>Conducted market research and competitor benchmarking to support brand positioning</li><li>Assisted in preparing marketing and sales presentations for external partners</li><li>Supported lead generation with a structured, data-driven approach</li></ul>\n      </div>\n    </div>\n  \n    <div class=\"exp-item\">\n      <div class=\"exp-dot\"></div>\n      <div>\n        <div class=\"exp-role\">Operations Intern</div>\n        <div class=\"exp-company\">Xerox IBSX, Cairo</div>\n        <div class=\"exp-date\">May 2022 – Jun 2022</div>\n        <ul class=\"exp-bullets\"><li>Coordinated internal meetings, communications, and cross-departmental workflows</li><li>Maintained organized documentation contributing to measurable improvements in operational efficiency</li></ul>\n      </div>\n    </div>\n  </div>\n\n    <div class=\"section-head\" style=\"margin-top:40px\">\n      <span class=\"section-title\">Education</span>\n    </div>\n    <div id=\"education-section\" class=\"exp-list\">\n    <div class=\"exp-item\">\n      <div class=\"exp-dot\"></div>\n      <div>\n        <div class=\"exp-role\">Dual Degree — Marketing &amp; International Business</div>\n        <div class=\"exp-company\">University of Greenwich / MSA University</div>\n        <div class=\"exp-date\">2019 – 2024 · Giza, Egypt</div>\n        <ul class=\"exp-bullets\"><li>Brand Management, Marketing Strategy, Consumer Behavior, Market Research</li><li>Digital Marketing, Financial Management, International Business</li></ul>\n      </div>\n    </div>\n  </div>\n  </div>\n\n  <!-- ABOUT -->\n  <div id=\"page-about\" class=\"page\">\n    <div class=\"section-head\">\n      <span class=\"section-title\">About Me</span>\n    </div>\n    <div class=\"about-grid\" style=\"margin-bottom:24px\">\n      <div class=\"about-card\" style=\"grid-column:1/-1\">\n        <div class=\"about-card-title\">Summary</div>\n        <p>Marketing and Business Development graduate with experience in campaign execution, market research, client communications, and performance reporting. Proven ability to manage multiple workflows simultaneously, coordinate with vendors and stakeholders, and deliver analytical insights that support commercial decision-making. Focused on media buying and marketing strategy with a long-term goal of growing into a senior brand leadership role.</p>\n      </div>\n      <div class=\"about-card\">\n        <div class=\"about-card-title\">Career Focus</div>\n        <p>Media Buying · Digital Marketing · Brand Management · Growth Marketing · Business Development · Campaign Management · Performance Marketing</p>\n      </div>\n      <div class=\"about-card\">\n        <div class=\"about-card-title\">Background</div>\n        <p>Giza, Egypt · MSA University / University of Greenwich graduate · Arabic native speaker · English C1 professional proficiency</p>\n      </div>\n    </div>\n  </div>\n\n  <!-- CONTACT -->\n  <div id=\"page-contact\" class=\"page\">\n    <div class=\"section-head\">\n      <span class=\"section-title\">Get In Touch</span>\n    </div>\n    <div class=\"contact-grid\" style=\"margin-bottom:30px\">\n      <div class=\"contact-card\">\n        <div class=\"contact-icon\">✉️</div>\n        <div>\n          <div class=\"contact-label\">Email</div>\n          <div class=\"contact-value\">Mohamed.ahmed9009mm@gmail.com</div>\n        </div>\n      </div>\n      <div class=\"contact-card\">\n        <div class=\"contact-icon\">📞</div>\n        <div>\n          <div class=\"contact-label\">Phone</div>\n          <div class=\"contact-value\">01125353053</div>\n        </div>\n      </div>\n      <div class=\"contact-card\">\n        <div class=\"contact-icon\">💼</div>\n        <div>\n          <div class=\"contact-label\">LinkedIn</div>\n          <div class=\"contact-value\">linkedin.com/in/mohamed-ahmed-210b41394</div>\n        </div>\n      </div>\n      <div class=\"contact-card\">\n        <div class=\"contact-icon\">📍</div>\n        <div>\n          <div class=\"contact-label\">Location</div>\n          <div class=\"contact-value\">Giza, Egypt</div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- ADMIN PANEL -->\n<div id=\"admin-panel\" class=\"admin-panel\">\n  <button class=\"admin-close\" onclick=\"toggleAdmin()\">✕</button>\n  <div class=\"admin-title\">📝 Edit Portfolio</div>\n  \n  <div class=\"admin-section\">\n    <div class=\"admin-section-title\">Add New Project</div>\n    <input class=\"admin-input\" id=\"proj-name\" placeholder=\"Project name\">\n    <input class=\"admin-input\" id=\"proj-subtitle\" placeholder=\"Subtitle\">\n    <input class=\"admin-input\" id=\"proj-desc\" placeholder=\"Description\">\n    <input class=\"admin-input\" id=\"proj-tags\" placeholder=\"Tags (comma separated)\">\n    <input class=\"admin-input\" id=\"proj-color\" type=\"color\" value=\"#cc0000\">\n    <div class=\"admin-btn-group\">\n      <button class=\"admin-btn-save\" onclick=\"addProject()\">Add Project</button>\n      <button class=\"admin-btn-cancel\" onclick=\"clearProjectForm()\">Clear</button>\n    </div>\n  </div>\n\n  <div class=\"admin-section\">\n    <div class=\"admin-section-title\">Backup &amp; Restore</div>\n    <button class=\"admin-btn-save\" onclick=\"downloadBackup()\" style=\"width:100%;margin-bottom:8px\">💾 Download Backup</button>\n    <button class=\"admin-btn-cancel\" onclick=\"document.getElementById('restore-file').click()\" style=\"width:100%\">📥 Restore from Backup</button>\n    <input type=\"file\" id=\"restore-file\" style=\"display:none\" accept=\".json\" onchange=\"restoreBackup()\">\n  </div>\n</div>\n\n<style>\n.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:30px}\n.about-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:20px 22px}\n.about-card-title{font-size:13px;font-weight:500;text-transform:uppercase;letter-spacing:1px;color:var(--accent);margin-bottom:12px}\n.about-card p{font-size:14px;color:var(--muted);line-height:1.7}\n.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}\n.contact-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:18px;display:flex;align-items:center;gap:14px}\n.contact-icon{width:40px;height:40px;border-radius:10px;background:#f0ede8;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0}\n.contact-label{font-size:12px;color:var(--muted)}\n.contact-value{font-size:14px;color:var(--primary);font-weight:500}\n@media(max-width:768px){\n  .about-grid{grid-template-columns:1fr}\n  .contact-grid{grid-template-columns:1fr}\n}\n</style>\n\n<script>\nlet adminMode = false;\nlet currentData = {\n  projects: [\n    {id:1,name:'Pizza Station',subtitle:'Brand Analysis & Campaign Strategy',desc:'Full competitive audit + two original campaign concepts',tags:['Campaign','Analysis','Meta Ads'],color:'linear-gradient(135deg,#cc0000,#ff4444)'},\n    {id:2,name:'Maine Egypt',subtitle:'Social Strategy & Campaign Design',desc:'Premium burger brand digital audit and campaign concept',tags:['F&B','Social Media','Events'],color:'linear-gradient(135deg,#bf4a00,#e86e1e)'},\n    {id:3,name:'Pablo & Abdo',subtitle:'Brand Strategy & Content Campaigns',desc:'GTA-themed fusion brand with activation campaigns',tags:['Brand Identity','Storytelling','UGC'],color:'linear-gradient(135deg,#0a0a0a,#2d2d2d)'},\n    {id:4,name:'AI & Smart Business',subtitle:'Academic Research Project',desc:'Market intelligence research on AI-driven business tools',tags:['Research','AI Strategy'],color:'linear-gradient(135deg,#1a3a6e,#2d5fb5)'}\n  ],\n  experience: [\n    {role:'Customer Relationship Manager',company:'Confidential — Marketing Operations, Giza',date:'Sep 2023 – Feb 2025',bullets:['Monitored client interaction data weekly, delivering trend insights directly applicable to campaign performance monitoring','Managed concurrent workflows across multiple client accounts with structured records and KPI tracking','Coordinated with internal teams and third-party vendors across deliverables and deadlines','Promoted within 12 months based on consistent output quality in a high-volume environment']},\n    {role:'Sales and Marketing Supervisor',company:'Mining City, Cairo',date:'Nov 2019 – Dec 2020',bullets:['Planned and executed BTL promotional campaigns for investment products, managing full delivery from strategy through activation','Led a team of 10, setting performance targets and tracking KPIs','Conducted competitive market analysis to identify positioning opportunities','Produced regular performance reports for senior-level decision-making']},\n    {role:'Marketing Intern',company:'Elsewedy Trading Enterprises, Cairo',date:'Jun 2023 – Jul 2023',bullets:['Supported planning and deployment of paid advertising campaigns across digital channels','Conducted competitive intelligence research to identify market opportunities','Contributed customer acquisition ideas adopted into the team\\'s promotional strategy']},\n    {role:'Business Development Intern',company:'Scientific and Trading, Cairo',date:'Feb 2023 – Mar 2023',bullets:['Conducted market research and competitor benchmarking to support brand positioning','Assisted in preparing marketing and sales presentations for external partners','Supported lead generation with a structured, data-driven approach']},\n    {role:'Operations Intern',company:'Xerox IBSX, Cairo',date:'May 2022 – Jun 2022',bullets:['Coordinated internal meetings, communications, and cross-departmental workflows','Maintained organized documentation contributing to measurable improvements in operational efficiency']}\n  ],\n  education: [{role:'Dual Degree — Marketing & International Business',company:'University of Greenwich / MSA University',date:'2019 – 2024 · Giza, Egypt',bullets:['Brand Management, Marketing Strategy, Consumer Behavior, Market Research','Digital Marketing, Financial Management, International Business']}],\n  skills: [\n    {title:'Marketing & Campaigns',items:['Campaign Planning','BTL Execution','Meta Ads Manager','Content Strategy','Brand Management','Performance Reporting']},\n    {title:'Business Development',items:['Market Research','Competitor Analysis','Lead Generation','Sales Presentations','Stakeholder Comms']},\n    {title:'Analytics & Reporting',items:['KPI Tracking','Data Analysis','Trend Analysis','Microsoft Excel']},\n    {title:'Languages & Tools',items:['Arabic (Native)','English (C1)','PowerPoint','Word']}\n  ]\n};\n\nfunction toggleAdmin(){\n  adminMode = !adminMode;\n  document.getElementById('admin-panel').classList.toggle('open');\n  document.querySelector('.port').classList.toggle('admin-mode', adminMode);\n  renderAll();\n}\n\nfunction showNotification(msg){\n  const notif = document.createElement('div');\n  notif.className = 'notification';\n  notif.textContent = msg;\n  document.body.appendChild(notif);\n  setTimeout(() => notif.remove(), 2000);\n}\n\nfunction addProject(){\n  const name = document.getElementById('proj-name').value;\n  const subtitle = document.getElementById('proj-subtitle').value;\n  const desc = document.getElementById('proj-desc').value;\n  const tags = document.getElementById('proj-tags').value.split(',').map(t => t.trim());\n  const color = document.getElementById('proj-color').value;\n  \n  if(!name) {showNotification('Please enter project name');return;}\n  \n  currentData.projects.push({\n    id: Date.now(),\n    name,\n    subtitle,\n    desc,\n    tags,\n    color: `linear-gradient(135deg,${color},${adjustColor(color,20)})`\n  });\n  \n  clearProjectForm();\n  renderAll();\n  showNotification('✅ Project added!');\n  saveData();\n}\n\nfunction clearProjectForm(){\n  document.getElementById('proj-name').value = '';\n  document.getElementById('proj-subtitle').value = '';\n  document.getElementById('proj-desc').value = '';\n  document.getElementById('proj-tags').value = '';\n}\n\nfunction adjustColor(color,percent){\n  const num = parseInt(color.replace('#',''),16);\n  const amt = Math.round(2.55 * percent);\n  const R = Math.min(255,(num >> 16) + amt);\n  const G = Math.min(255,(num >> 8 & 0x00FF) + amt);\n  const B = Math.min(255,(num & 0x0000FF) + amt);\n  return '#' + (0x1000000 + (R<255?R<1?0:R:255)*0x10000 + (G<255?G<1?0:G:255)*0x100 + (B<255?B<1?0:B:255)).toString(16).slice(1);\n}\n\nfunction renderProjects(){\n  const featured = document.getElementById('featured-projects');\n  const all = document.getElementById('all-projects');\n  \n  featured.innerHTML = currentData.projects.slice(0,2).map(p => projectCard(p)).join('');\n  all.innerHTML = currentData.projects.map(p => projectCard(p)).join('');\n}\n\nfunction projectCard(p){\n  return `<div class=\"proj-card ${adminMode?'admin-mode':''}\">\n    <div class=\"proj-thumb\" style=\"background:${p.color}\">\n      <div class=\"proj-thumb-label\">\n        <div class=\"proj-thumb-name\">${p.name}</div>\n        <div class=\"proj-thumb-sub\">${p.subtitle}</div>\n      </div>\n    </div>\n    <div class=\"proj-body\">\n      <div class=\"proj-tags\">${p.tags.map(t => `<span class=\"proj-tag\">${t}</span>`).join('')}</div>\n      <p class=\"proj-desc\">${p.desc}</p>\n      <button class=\"delete-btn\" onclick=\"deleteProject(${p.id})\">🗑 Delete</button>\n    </div>\n  </div>`;\n}\n\nfunction deleteProject(id){\n  if(confirm('Delete this project?')){\n    currentData.projects = currentData.projects.filter(p => p.id !== id);\n    renderAll();\n    showNotification('✅ Project deleted');\n    saveData();\n  }\n}\n\nfunction renderExperience(){\n  const section = document.getElementById('experience-section');\n  section.innerHTML = currentData.experience.map(exp => `\n    <div class=\"exp-item\">\n      <div class=\"exp-dot\"></div>\n      <div>\n        <div class=\"exp-role\">${exp.role}</div>\n        <div class=\"exp-company\">${exp.company}</div>\n        <div class=\"exp-date\">${exp.date}</div>\n        <ul class=\"exp-bullets\">${exp.bullets.map(b => `<li>${b}</li>`).join('')}</ul>\n      </div>\n    </div>\n  `).join('');\n}\n\nfunction renderEducation(){\n  const section = document.getElementById('education-section');\n  section.innerHTML = currentData.education.map(edu => `\n    <div class=\"exp-item\">\n      <div class=\"exp-dot\"></div>\n      <div>\n        <div class=\"exp-role\">${edu.role}</div>\n        <div class=\"exp-company\">${edu.company}</div>\n        <div class=\"exp-date\">${edu.date}</div>\n        <ul class=\"exp-bullets\">${edu.bullets.map(b => `<li>${b}</li>`).join('')}</ul>\n      </div>\n    </div>\n  `).join('');\n}\n\nfunction renderSkills(){\n  const section = document.getElementById('skills-section');\n  section.innerHTML = currentData.skills.map(g => `\n    <div class=\"skill-group\">\n      <div class=\"skill-group-title\">${g.title}</div>\n      <div class=\"skill-tags\">${g.items.map(i => `<span class=\"skill-tag\">${i}</span>`).join('')}</div>\n    </div>\n  `).join('');\n}\n\nfunction renderAll(){\n  renderProjects();\n  renderExperience();\n  renderEducation();\n  renderSkills();\n}\n\nfunction saveData(){\n  localStorage.setItem('portfolioData', JSON.stringify(currentData));\n}\n\nfunction loadData(){\n  const saved = localStorage.getItem('portfolioData');\n  if(saved) currentData = JSON.parse(saved);\n  renderAll();\n}\n\nfunction downloadBackup(){\n  const backup = JSON.stringify(currentData, null, 2);\n  const blob = new Blob([backup], {type:'application/json'});\n  const url = URL.createObjectURL(blob);\n  const a = document.createElement('a');\n  a.href = url;\n  a.download = `portfolio-backup-${new Date().toISOString().split('T')[0]}.json`;\n  a.click();\n  showNotification('💾 Backup downloaded!');\n}\n\nfunction restoreBackup(){\n  const file = document.getElementById('restore-file').files[0];\n  if(!file) return;\n  \n  const reader = new FileReader();\n  reader.onload = function(e){\n    try{\n      const restored = JSON.parse(e.target.result);\n      if(confirm('Replace all data with backup? This cannot be undone!')){\n        currentData = restored;\n        saveData();\n        loadData();\n        showNotification('✅ Backup restored!');\n      }\n    }catch(err){\n      showNotification('❌ Invalid backup file');\n    }\n  };\n  reader.readAsText(file);\n}\n\nfunction showPage(id){\n  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));\n  document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));\n  document.getElementById('page-' + id).classList.add('active');\n  const btn = [...document.querySelectorAll('.nav-btn')].find(b => b.textContent.toLowerCase().includes(id.toLowerCase()));\n  if(btn) btn.classList.add('active');\n  window.scrollTo(0,0);\n}\n\nloadData();\n</script>\n\n</body></html>",
